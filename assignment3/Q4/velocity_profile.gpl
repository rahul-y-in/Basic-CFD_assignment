#!/usr/bin/gnuplot


clear
reset

# Set output terminal (e.g., for viewing on screen)
#set terminal qt
#set terminal pngcairo size 1200,1000
set terminal svg size 1200,1200 background "white"

# Set a title for the graph

# Set labels for the axes
set xlabel "y/{\delta(4)}" font ",24" offset 0,-1
set ylabel "u/u_{\infinity}" offset -2 font ",24"

set tics font ",24"
# Set the y-axis to logarithmic scale (default is base 10)
#set logscale x

# Format the y-axis tic labels to exponential notation
#set format y "10^{%T}"

set lmargin 6
set rmargin 4
set tmargin 4
set bmargin 6
set size ratio 1
set key font ",22"

set grid

set output "profile.svg"
# Plot the data, specifying a different color for each line
plot  "BL_Solution_U_non-dimensional.dat" using 1:4002 with lines title "x=0.4" linecolor "dark-green" dashtype (5,5) linewidth 3,\
	"BL_Solution_U_non-dimensional.dat" using 1:402 with lines title "x=0.04" linecolor "blue" dashtype (5,5) linewidth 3,\
	"BL_Solution_U_non-dimensional.dat" using 1:42 with lines title "x=0.004" linecolor "green" dashtype (5,5) linewidth 3,\
	"BL_Solution_U_non-dimensional.dat" using 1:20002 with lines title "x=2" linecolor "green" dashtype (5,5) linewidth 3,\
	"BL_Solution_U_non-dimensional.dat" using 1:40002 with lines title "x=4" linecolor "black" dashtype (5,5) linewidth 3
unset output

set logscale x
set output "profile_in_logscale.svg"
# Plot the data, specifying a different color for each line
plot  "BL_Solution_U_non-dimensional.dat" using 1:4002 with lines title "x=0.4" linecolor "dark-green" dashtype (5,5) linewidth 3,\
	"BL_Solution_U_non-dimensional.dat" using 1:402 with lines title "x=0.04" linecolor "blue" dashtype (5,5) linewidth 3,\
	"BL_Solution_U_non-dimensional.dat" using 1:42 with lines title "x=0.004" linecolor "green" dashtype (5,5) linewidth 3,\
	"BL_Solution_U_non-dimensional.dat" using 1:20002 with lines title "x=2" linecolor "green" dashtype (5,5) linewidth 3,\
	"BL_Solution_U_non-dimensional.dat" using 1:40002 with lines title "x=4" linecolor "black" dashtype (5,5) linewidth 3
unset output
