#!/usr/bin/gnuplot


clear
reset

# Set output terminal (e.g., for viewing on screen)
#set terminal qt
#set terminal pngcairo size 1200,1000
set terminal svg size 1200,1200 background "white"

# Set a title for the graph

# Set labels for the axes
set xlabel "x" font ",24" offset 0,-1
set ylabel "u(x)" offset -2 font ",24"

set tics font ",24"
# Set the y-axis to logarithmic scale (default is base 10)
#set logscale x

# Format the y-axis tic labels to exponential notation
#set format y "10^{%T}"

set lmargin 6
set rmargin 4
set tmargin 4
set bmargin 6
set size ratio 1
set key font ",22"

set grid

set output "solution_at_0.2_dt_1e-3.svg"
# Plot the data, specifying a different color for each line
plot  "FTCS_Solution_dt_0.1E-02.dat" using 1:202 with lines title "FTCS_Solution.dat" linecolor "dark-green" dashtype (5,5) linewidth 3,\
	"MacCormack_Solution_dt_0.1E-02.dat" using 1:202 with lines title "MacCormack_Solution" linecolor "green" dashtype (5,5) linewidth 3,\
	"FTUWCS_Solution_dt_0.1E-02.dat" using 1:202 with lines title "FTUWCS_Solution" linecolor "blue" dashtype (5,5) linewidth 3
unset output

#set logscale x
set output "solution_at_0.2_dt_2e-3.svg"
# Plot the data, specifying a different color for each line
plot  "FTCS_Solution_dt_0.2E-02.dat" using 1:102 with lines title "FTCS_Solution.dat" linecolor "dark-green" dashtype (5,5) linewidth 3,\
	"MacCormack_Solution_dt_0.2E-02.dat" using 1:102 with lines title "MacCormack_Solution" linecolor "green" dashtype (5,5) linewidth 3,\
	"FTUWCS_Solution_dt_0.2E-02.dat" using 1:102 with lines title "FTUWCS_Solution" linecolor "blue" dashtype (5,5) linewidth 3
unset output
